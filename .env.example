# Set these same two PUBLIC values in Vercel, then redeploy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Do not add the service_role key or database password to any VITE_ variable.

# Optional local-only sandbox; ignored in production builds.
VITE_CMS_PREVIEW=false
